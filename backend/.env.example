# Existing Supabase project credentials. Keep the service-role key server-side only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Server settings
PORT=3001
FRONTEND_ORIGIN=http://localhost:5500

# The supplied frontend has only a client-side/mock login (sessionStorage).
# Because the backend must not trust that, these env vars provide the server-side
# credential used to create the HttpOnly session cookie.
ADMIN_EMAIL=
ADMIN_PASSWORD=
SESSION_SECRET=change-this-to-a-long-random-value

# Optional column overrides. Defaults match the names requested by the project.
CLIENT_ID_COLUMN=id
CLIENT_NAME_COLUMN=client_name
OMNI_AGENT_ID_COLUMN=omnidimension_agent_id
OMNI_FROM_NUMBER_ID_COLUMN=omnidimension_from_number_id
